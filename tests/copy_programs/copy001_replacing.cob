       IDENTIFICATION DIVISION.
       PROGRAM-ID. COPY001.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       COPY CPY_TAG
           REPLACING ==:TAG:== BY ==WS==.
       COPY CPY_TAG REPLACING ==:TAG:== BY ==AUX==.
       COPY CPY_W REPLACING OLD-NAME BY NEW-NAME.
       PROCEDURE DIVISION.
       INICIO.
           DISPLAY WS-CAMPO " " WS-NUM.
           DISPLAY AUX-CAMPO " " AUX-NUM.
           DISPLAY NEW-NAME " " OLD-NAME-X.
           STOP RUN.

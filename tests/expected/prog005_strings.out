CONT=09 - AFTER INITIAL ' '
YESNO=1 - FOR LEADING 'H' 0=N / 1=Y
SAUX='HALLO WORLD 123' - REPLACING FIRST 'E' BY 'A'
SAUX='HAPPY WORLD 123' - REPLACING ALL 'LLO' BY 'PPY'
SAUX=' GOOD-DAY      ' - HOLA-DAY TO GOOD-DAY'
SAUX='hello world    ' - CONVERTING'
SAUX='FFFFFFFFFFFFFFF' - REPLACING 
